<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_background">

    <!-- Main content for the suggested recipes screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSuggestedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suggested Recipes"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/dark_green"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <TextView
            android:id="@+id/tvSuggestedSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipes you can make with your current pantry"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp" />

        <!-- Holds the recipe list or the empty state message -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRecipes"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Shown when no recipes match the current pantry -->
            <TextView
                android:id="@+id/tvNoRecipes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="No recipes available yet.&#10;&#10;Add more ingredients to your pantry to unlock recipes."
                android:textAlignment="center"
                android:textSize="17sp"
                android:textColor="@color/text_light"
                android:padding="30dp" />

        </FrameLayout>

    </LinearLayout>

    <!-- Main navigation between Pantry, Recipes and Settings -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@style/SmartPantryBottomNavIndicator" />

</LinearLayout>