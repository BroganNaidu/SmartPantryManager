<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F5EF">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2F4F3E"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingredients you currently have at home"
        android:textSize="15sp"
        android:textColor="#666666"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Your pantry is empty.\nAdd an ingredient to get started."
        android:textAlignment="center"
        android:textSize="17sp"
        android:textColor="#777777" />

    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:layout_marginBottom="10dp" />

</LinearLayout>